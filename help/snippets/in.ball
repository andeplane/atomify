# A soft liquid with a sticky ball of type 2 atoms in the middle
#/camera position 27 21 32
#/camera target 8.4 8.4 8.4
#/atom 1 0.5 #7D9BE8
#/atom 2 0.6 #F43F5E

units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 10 0 10 0 10
create_box 2 box
create_atoms 1 box
region ball sphere 5 5 5 3
set region ball type 2
group ball type 2
mass * 1.0
velocity all create 0.8 4928459 loop geom
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
pair_coeff 2 2 1.5 1.0 2.5
pair_coeff 1 2 1.2 1.0 2.5
compute ke all ke/atom
fix 1 all nvt temp 0.8 0.8 0.5
thermo 100
run 200000

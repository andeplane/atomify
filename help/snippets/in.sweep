# 864 Lennard-Jones atoms: how does the temperature we start at change things?
#/atom 1 0.6 #3F6EFF

variable T equal 1.44   # initial temperature
print "Sweep check: T = ${T}"

units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 6 0 6 0 6
create_box 1 box
create_atoms 1 box
mass 1 1.0
velocity all create ${T} 87287 loop geom
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
neighbor 0.3 bin
neigh_modify every 20 delay 0 check no
fix 1 all nve
compute msd all msd
thermo_style custom step temp pe press c_msd[4]
thermo 100
run 5000

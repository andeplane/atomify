# 864 Lennard-Jones atoms in a hot liquid: measure the diffusion coefficient
#/atom 1 0.6 #3F6EFF

variable T equal 1.44   # initial temperature
units lj
atom_style atomic
lattice fcc 0.8442
region box block 0 6 0 6 0 6
create_box 1 box
create_atoms 1 box
mass 1 1.0
velocity all create ${T} 87287 loop geom
pair_style lj/cut 2.5
pair_coeff 1 1 1.0 1.0 2.5
neighbor 0.3 bin
neigh_modify every 20 delay 0 check no
fix 1 all nve

# Mean square displacement, and a running estimate of D = MSD / (6 t)
compute msd all msd
variable D equal c_msd[4]/(6*(step*dt+1.0e-6))
thermo_style custom step temp pe c_msd[4] v_D
thermo 100
run 20000
